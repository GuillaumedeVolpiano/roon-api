cabal-version:   3.12
name:            roon-api
version:         0.1.0.0
synopsis:        Client library for the Roon extension API
description:
  An independent, unofficial Haskell implementation of the protocol that
  Roon extensions use to talk to a Roon Server: MOO messages over a
  WebSocket, extension registration, and (in later versions) the
  transport and browse services. Built on Effectful and Streamly.

homepage:        https://github.com/GuillaumedeVolpiano/roon-api
license:         BSD-3-Clause
license-file:    LICENSE
author:          GuillaumedeVolpiano
maintainer:      xavier@wheredoibegin.fr
category:        Sound, Network
build-type:      Simple
tested-with:     GHC ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/roon-api.git

common shared
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    TypeFamilies

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Roon.Browse
    Roon.Connection
    Roon.Effect.Moo
    Roon.Effect.TokenStore
    Roon.Effect.WebSocket
    Roon.Error
    Roon.Moo.Message
    Roon.Registry
    Roon.Service
    Roon.Transport

  build-depends:
    , aeson                ^>=2.3
    , base                 ^>=4.21
    , bytestring           ^>=0.12
    , containers           ^>=0.7
    , effectful            ^>=2.7
    , effectful-core       ^>=2.7.1
    , effectful-streamly   ^>=0.1
    , effectful-websockets ^>=0.1
    , filepath             ^>=1.5
    , streamly-bytestring  ^>=0.2.3
    , streamly-core        ^>=0.3.3
    , text                 ^>=2.1

executable roon-probe
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base       ^>=4.21
    , effectful  ^>=2.7
    , roon-api
    , text       ^>=2.1

test-suite roon-api-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    Roon.BrowseSpec
    Roon.ConnectionSpec
    Roon.Effect.TokenStoreSpec
    Roon.Effect.WebSocketSpec
    Roon.Moo.MessageSpec
    Roon.Test.Server
    Roon.TransportSpec

  ghc-options:    -threaded
  build-depends:
    , aeson             ^>=2.3
    , async             ^>=2.2
    , base              ^>=4.21
    , bytestring        ^>=0.12
    , containers        ^>=0.7
    , directory         ^>=1.3
    , effectful         ^>=2.7
    , filepath          ^>=1.5
    , network           ^>=3.2
    , roon-api
    , stm               ^>=2.5
    , streamly-core     ^>=0.3.3
    , temporary         ^>=1.3
    , unix              ^>=2.8
    , websockets        ^>=0.13
    , text              ^>=2.1
    , tasty             ^>=1.5
    , tasty-hunit       ^>=0.10
    , tasty-quickcheck  ^>=0.11
